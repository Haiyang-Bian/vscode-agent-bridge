{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bridge: Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder:VS Code Extension}",
        "--user-data-dir=${workspaceFolder:Repository}/.vscode-test/manual/user-data",
        "--extensions-dir=${workspaceFolder:Repository}/.vscode-test/manual/extensions"
      ],
      "outFiles": [
        "${workspaceFolder:VS Code Extension}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "preLaunchTask": "Bridge: Build all"
    },
    {
      "name": "Bridge: Debug active Bun test",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "runtime": "bun",
      "runtimeArgs": ["test"],
      "cwd": "${workspaceFolder:Repository}",
      "stopOnEntry": false,
      "watchMode": false
    },
    {
      "name": "Bridge: Debug active Bun file",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "runtime": "bun",
      "runtimeArgs": [],
      "cwd": "${workspaceFolder:Repository}",
      "stopOnEntry": false,
      "watchMode": false
    }
  ]
}
