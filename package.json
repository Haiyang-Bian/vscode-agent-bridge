{
  "name": "vscode-agent-bridge",
  "version": "0.8.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/run-workspaces.ts build",
    "typecheck": "bun scripts/run-workspaces.ts typecheck",
    "test": "bun test",
    "test:e2e": "bun scripts/run-extension-e2e.ts",
    "test:artifact": "bun scripts/test-artifacts.ts",
    "check": "bun scripts/check.ts",
    "build:mcp:exe": "bun scripts/build-mcp-executable.ts",
    "package:vsix": "bun scripts/package-vsix.ts",
    "package:test-bundle": "bun scripts/create-test-bundle.ts",
    "verify:release": "bun scripts/verify-release.ts",
    "release:checksums": "bun scripts/create-checksums.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/mocha": "10.0.10",
    "@vscode-agent-bridge/protocol": "workspace:*",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.3-4",
    "typescript": "7.0.2"
  }
}
