{
  "name": "vscode-agent-bridge",
  "displayName": "VS Code Agent Bridge",
  "description": "Expose IDE-native VS Code context to local MCP clients through an authenticated bridge.",
  "version": "0.14.0",
  "publisher": "AliceLin",
  "license": "MIT",
  "icon": "resources/icon.png",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haiyang-Bian/vscode-agent-bridge.git"
  },
  "homepage": "https://github.com/Haiyang-Bian/vscode-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/Haiyang-Bian/vscode-agent-bridge/issues"
  },
  "keywords": [
    "mcp",
    "codex",
    "agent",
    "language-service",
    "developer-tools"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#071B33",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Local configuration and Doctor commands remain available, but the MCP bridge is not published until the workspace is trusted."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "VS Code Agent Bridge",
      "properties": {
        "vscodeAgentBridge.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Publish this local trusted VS Code window to configured MCP clients."
        },
        "vscodeAgentBridge.enableAcceptanceFixtures": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Register a deterministic pure-text Code Action fixture for acceptance testing. Keep disabled during normal use."
        }
      }
    },
    "commands": [
      {
        "command": "vscodeAgentBridge.showStatus",
        "title": "VS Code Agent Bridge: Show Status"
      },
      {
        "command": "vscodeAgentBridge.copyInstanceId",
        "title": "VS Code Agent Bridge: Copy Instance ID"
      },
      {
        "command": "vscodeAgentBridge.configureCodex",
        "title": "VS Code Agent Bridge: Configure Codex"
      },
      {
        "command": "vscodeAgentBridge.configureBridge",
        "title": "VS Code Agent Bridge: Configure Bridge"
      },
      {
        "command": "vscodeAgentBridge.removeCodexConfiguration",
        "title": "VS Code Agent Bridge: Remove Codex Configuration"
      },
      {
        "command": "vscodeAgentBridge.runDoctor",
        "title": "VS Code Agent Bridge: Run Doctor"
      },
      {
        "command": "vscodeAgentBridge.undoLastAgentProfileChange",
        "title": "VS Code Agent Bridge: Undo Last Agent Profile Change"
      },
      {
        "command": "vscodeAgentBridge.createCapabilityProfile",
        "title": "VS Code Agent Bridge: Create Capability Profile"
      },
      {
        "command": "vscodeAgentBridge.refreshHub",
        "title": "VS Code Agent Bridge: Refresh Hub"
      },
      {
        "command": "vscodeAgentBridge.clearUsageInsights",
        "title": "VS Code Agent Bridge: Clear Local Usage Insights"
      },
      {
        "command": "vscodeAgentBridge.exportUsageInsights",
        "title": "VS Code Agent Bridge: Export Usage Insights"
      },
      {
        "command": "vscodeAgentBridge.openLegacyExperimentData",
        "title": "VS Code Agent Bridge: Open Legacy Experiment Data Location"
      },
      {
        "command": "vscodeAgentBridge.deleteLegacyExperimentData",
        "title": "VS Code Agent Bridge: Delete Legacy Experiment Data"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodeAgentBridge",
          "title": "VS Code Agent Bridge",
          "icon": "resources/experiment.svg"
        }
      ]
    },
    "views": {
      "vscodeAgentBridge": [
        {
          "id": "vscodeAgentBridge.statusView",
          "name": "Status"
        },
        {
          "id": "vscodeAgentBridge.agentActivityView",
          "name": "Agent Activity"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vscodeAgentBridge.statusView",
        "contents": "[Configure Codex](command:vscodeAgentBridge.configureCodex)\n[Run Doctor](command:vscodeAgentBridge.runDoctor)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscodeAgentBridge.refreshHub",
          "when": "view == vscodeAgentBridge.statusView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --sourcemap=external",
    "build:test:e2e": "bun build ./test/e2e/extension.e2e.ts --outdir=dist-test/e2e --target=node --format=cjs --external=vscode",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@vscode-agent-bridge/protocol": "workspace:*",
    "@vscode/python-extension": "1.0.6",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0"
  }
}
