{
  "name": "@vscode-agent-bridge/mcp-server",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "bin": {
    "vscode-agent-bridge-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --sourcemap=external",
    "build:exe": "bun run --cwd ../.. build:mcp:exe",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vscode-agent-bridge/protocol": "workspace:*",
    "zod": "4.4.3"
  }
}
